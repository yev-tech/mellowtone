<!-- mellowtone:design 360x480 -->
<!--
  "Cover first" for the R3 Pro's 360x480 screen,
  scaled to other panels by the loader (the marker above; player_layouts.c).
  The cover is the hero at 250 px; title and artist sit below it on two
  lines with the heart beside them; one meta line carries elapsed time,
  format and duration; the transport row is play mode, previous,
  play/pause, next, more (more opens the Now panel: Up next, Lyrics, Info,
  More); it ends 34 px above the bottom edge so the home-gesture strip stays clear. The background is flat (no blurred cover), which costs no
  redraws on track change. Tap the cover for lyrics.
-->
<component>
    <consts>
        <px name="cover_size" value="250"/>
    </consts>

    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false"
          style_bg_color="0x0d0f0e" style_bg_opa="255" style_border_width="0"
          style_radius="0" style_pad_all="0">

        <lv_obj name="cover_card" x="55" y="28" width="#cover_size" height="#cover_size" scrollable="false"
                style_radius="10" style_clip_corner="true"
                style_bg_color="0x1e2123" style_bg_opa="255" style_border_width="0" style_pad_all="0">
            <lv_image name="cover_img" src="default_cover" align="center"/>
        </lv_obj>

        <lv_label name="title" text="" x="24" y="284" width="272"
                  style_text_font="font_22" style_text_color="0xeceee9"/>
        <lv_label name="artist" text="" x="24" y="310" width="272"
                  style_text_font="player_meta" style_text_color="0xa3a89f"/>

        <lv_obj name="favorite_circle" x="298" y="282" width="44" height="44" scrollable="false"
                style_radius="100" style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="favorite_icon" src="collect_out" align="center"/>
        </lv_obj>

        <lv_slider name="progress_slider" x="24" y="342" width="312" height="6"
                   style_bg_color="0x3a3f3c" style_bg_opa="255" style_radius="6"/>

        <lv_label name="pos_label" text="0:00" x="24" y="356"
                  style_text_font="player_meta" style_text_color="0xa3a89f"/>
        <lv_obj name="quality_pill" x="0" y="354" width="#screen_w" height="22" scrollable="false"
                flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
                style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_label name="format_badge" text="" style_text_font="font_16" style_text_color="0xcfd2cc"/>
        </lv_obj>
        <lv_label name="dur_label" text="--:--" align="top_right" x="-24" y="356"
                  style_text_font="player_meta" style_text_color="0xa3a89f"/>

        <lv_obj name="transport" x="16" y="380" width="328" height="66" scrollable="false"
                flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                style_bg_opa="0" style_border_width="0" style_pad_all="0">
            <lv_image name="order_btn" src="order" width="40" height="40" inner_align="center"/>
            <lv_image name="prev_btn" src="btn_prev"/>
            <lv_obj name="play_circle" width="64" height="64" scrollable="false"
                    style_bg_opa="0" style_border_width="0" style_pad_all="0">
                <lv_image name="play_btn" src="btn_play" align="center" width="64" height="64" inner_align="contain"/>
            </lv_obj>
            <lv_image name="next_btn" src="btn_next"/>
            <lv_image name="more_btn" src="ic_more"/>
        </lv_obj>

        <lv_slider name="volume_slider" width="100" height="10" hidden="true"/>
    </view>
</component>
