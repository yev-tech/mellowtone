+/*
+ * HiBy codec layer (AAC, aptX, LDAC, UAT, UAT-TWS).
+ * Capability bytes are byte-identical to HiBy's stock fw 2.2 bluetoothd so the
+ * stock ALSA plugin / remote negotiation behave the same.
+ */
+int a2dp_aptx_support = 0;
+int a2dp_ldac_support = 0;
+int a2dp_uat_support = 0;
+int a2dp_uat_tws_support = 0;
+int a2dp_aac_support = 0;
+
+static const uint8_t aac_codec_info[] =
+	{ 0x00, A2DP_CODEC_MPEG24, 0xc0, 0xff, 0xfc, 0x84, 0xe2, 0x00 };
+static const uint8_t aptx_codec_info[] =
+	{ 0x00, A2DP_CODEC_VENDOR, 0x4f, 0x00, 0x00, 0x00, 0x01, 0x00, 0xf3 };
+static const uint8_t ldac_codec_info[] =
+	{ 0x00, A2DP_CODEC_VENDOR, 0x2d, 0x01, 0x00, 0x00, 0xaa, 0x00,
+								0x3c, 0x07 };
+static const uint8_t uat_codec_info[] =
+	{ 0x00, A2DP_CODEC_VENDOR, 0xcc, 0x06, 0x00, 0x00, 0x01, 0x00,
+								0x3f, 0x07 };
+static const uint8_t uat_tws_codec_info[] =
+	{ 0x00, A2DP_CODEC_VENDOR, 0xcc, 0x06, 0x00, 0x00, 0x02, 0x00,
+								0x0f, 0x07 };
+
+static gboolean hiby_getcap(struct a2dp_sep *a2dp_sep,
+				struct avdtp_local_sep *sep, gboolean get_all,
+				GSList **caps, const uint8_t *info, size_t len,
+				const char *name)
+{
+	struct avdtp_service_capability *cap;
+
+	if (a2dp_sep->type == AVDTP_SEP_TYPE_SINK)
+		DBG("%s Sink %p: Get_Capability_Ind", name, sep);
+	else
+		DBG("%s Source %p: Get_Capability_Ind", name, sep);
+
+	*caps = NULL;
+
+	cap = avdtp_service_cap_new(AVDTP_MEDIA_TRANSPORT, NULL, 0);
+	*caps = g_slist_append(*caps, cap);
+
+	cap = avdtp_service_cap_new(AVDTP_MEDIA_CODEC, (void *) info, len);
+	*caps = g_slist_append(*caps, cap);
+
+	if (get_all) {
+		cap = avdtp_service_cap_new(AVDTP_DELAY_REPORTING, NULL, 0);
+		*caps = g_slist_append(*caps, cap);
+	}
+
+	return TRUE;
+}
+
+#define HIBY_GETCAP(fn, info, name)					\
+static gboolean fn(struct avdtp *session, struct avdtp_local_sep *sep,	\
+			gboolean get_all, GSList **caps, uint8_t *err,	\
+			void *user_data)					\
+{									\
+	return hiby_getcap(user_data, sep, get_all, caps, info,		\
+						sizeof(info), name);	\
+}
+
+HIBY_GETCAP(aac_getcap_ind, aac_codec_info, "AAC")
+HIBY_GETCAP(aptx_getcap_ind, aptx_codec_info, "APTX")
+HIBY_GETCAP(ldac_getcap_ind, ldac_codec_info, "LDAC")
+HIBY_GETCAP(uat_getcap_ind, uat_codec_info, "UAT")
+HIBY_GETCAP(uat_tws_getcap_ind, uat_tws_codec_info, "UAT TWS")
+
+/* Set_Configuration_Ind for AAC/vendor codecs: as sbc_setconf_ind but
+ * without SBC bitpool validation. */
+static gboolean hiby_setconf_ind(struct avdtp *session,
+					struct avdtp_local_sep *sep,
+					struct avdtp_stream *stream,
+					GSList *caps,
+					avdtp_set_configuration_cb cb,
+					void *user_data)
+{
+	struct a2dp_sep *a2dp_sep = user_data;
+	struct a2dp_setup *setup;
+
+	if (a2dp_sep->type == AVDTP_SEP_TYPE_SINK)
+		DBG("Sink %p: Set_Configuration_Ind", sep);
+	else
+		DBG("Source %p: Set_Configuration_Ind", sep);
+
+	setup = a2dp_setup_get(session);
+	if (!setup)
+		return FALSE;
+
+	a2dp_sep->stream = stream;
+	setup->sep = a2dp_sep;
+	setup->stream = stream;
+	setup->setconf_cb = cb;
+
+	for (; caps != NULL; caps = g_slist_next(caps)) {
+		struct avdtp_service_capability *cap = caps->data;
+
+		if (cap->category == AVDTP_DELAY_REPORTING &&
+					!a2dp_sep->delay_reporting) {
+			setup->err = g_new(struct avdtp_error, 1);
+			avdtp_error_init(setup->err, AVDTP_DELAY_REPORTING,
+					AVDTP_UNSUPPORTED_CONFIGURATION);
+			break;
+		}
+	}
+
+	g_idle_add(auto_config, setup);
+	return TRUE;
+}
