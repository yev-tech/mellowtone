+/*
+ * HiBy vendor A2DP codec identifiers (aptX, LDAC, UAT, UAT-TWS) as used by
+ * HiBy R3 Pro fw 2.2 bluetoothd and its ALSA plugin.
+ */
+#ifndef __HIBY_CODECS_H
+#define __HIBY_CODECS_H
+
+#include <stdint.h>
+
+#ifndef A2DP_CODEC_VENDOR
+#define A2DP_CODEC_VENDOR		0xFF
+#endif
+
+#define APTX_VENDOR_ID			0x0000004F
+#define APTX_CODEC_ID			0x0001
+#define LDAC_VENDOR_ID			0x0000012D
+#define LDAC_CODEC_ID			0x00AA
+#define UAT_VENDOR_ID			0x000006CC
+#define UAT_CODEC_ID			0x0001
+#define UAT_TWS_CODEC_ID		0x0002
+
+typedef struct {
+	uint32_t vendor_id;
+	uint16_t codec_id;
+} __attribute__ ((packed)) a2dp_vendor_codec_t;
+
+#endif /* __HIBY_CODECS_H */
