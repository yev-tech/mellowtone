+
+/* HiBy: is this remote vendor codec one we registered locally? */
+gboolean a2dp_codec_support(struct avdtp_media_codec_capability *codec)
+{
+	a2dp_vendor_codec_t *vc = (void *) codec->data;
+	uint32_t vid = btohl(vc->vendor_id);
+	uint16_t cid = btohs(vc->codec_id);
+
+	if (vid == APTX_VENDOR_ID && cid == APTX_CODEC_ID)
+		return a2dp_aptx_support > 0;
+	if (vid == LDAC_VENDOR_ID && cid == LDAC_CODEC_ID)
+		return a2dp_ldac_support > 0;
+	if (vid == UAT_VENDOR_ID && cid == UAT_CODEC_ID)
+		return a2dp_uat_support > 0;
+	if (vid == UAT_VENDOR_ID && cid == UAT_TWS_CODEC_ID)
+		return a2dp_uat_tws_support > 0;
+
+	return FALSE;
+}
+
+uint8_t a2dp_get_sep_codec(struct a2dp_sep *sep)
+{
+	return sep->codec;
+}
+
+uint32_t a2dp_get_sep_vendor_id(struct a2dp_sep *sep)
+{
+	return sep->vendor_id;
+}
+
+uint16_t a2dp_get_sep_codec_id(struct a2dp_sep *sep)
+{
+	return sep->codec_id;
+}
+
+/* HiBy: reconfigure an already-open stream in place (same SEP, new codec
+ * parameters) with AVDTP RECONFIGURE instead of close + reopen. */
+unsigned int a2dp_reconfig(struct avdtp *session, struct a2dp_sep *sep,
+				a2dp_config_cb_t cb, GSList *caps,
+				void *user_data)
+{
+	struct a2dp_setup_cb *cb_data;
+	struct a2dp_setup *setup;
+
+	if (!sep->stream || avdtp_sep_get_state(sep->lsep) != AVDTP_STATE_OPEN)
+		return 0;
+
+	setup = a2dp_setup_get(session);
+	if (!setup)
+		return 0;
+
+	cb_data = setup_cb_new(setup);
+	cb_data->config_cb = cb;
+	cb_data->user_data = user_data;
+
+	setup->sep = sep;
+	setup->stream = sep->stream;
+	setup->rsep = avdtp_stream_get_remote_sep(sep->stream);
+
+	if (setup->caps != caps) {
+		g_slist_free_full(setup->caps, g_free);
+		setup->caps = g_slist_copy(caps);
+	}
+
+	DBG("a2dp_reconfig: selected SEP %p", sep->lsep);
+
+	setup->inplace_reconf = TRUE;
+	if (avdtp_reconfigure(session, caps, sep->stream) < 0) {
+		setup->inplace_reconf = FALSE;
+		setup_cb_free(cb_data);
+		return 0;
+	}
+
+	return cb_data->id;
+}
