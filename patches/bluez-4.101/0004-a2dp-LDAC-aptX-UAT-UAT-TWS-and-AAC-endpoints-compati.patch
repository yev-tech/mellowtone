+static struct avdtp_sep_ind *hiby_codec_ind(uint8_t codec, uint32_t vid,
+								uint16_t cid)
+{
+	switch (codec) {
+	case A2DP_CODEC_SBC:
+		return &sbc_ind;
+	case A2DP_CODEC_MPEG12:
+		return &mpeg_ind;
+	case A2DP_CODEC_MPEG24:
+		return &aac_ind;
+	case A2DP_CODEC_VENDOR:
+		if (vid == APTX_VENDOR_ID && cid == APTX_CODEC_ID)
+			return &aptx_ind;
+		if (vid == LDAC_VENDOR_ID && cid == LDAC_CODEC_ID)
+			return &ldac_ind;
+		if (vid == UAT_VENDOR_ID && cid == UAT_CODEC_ID)
+			return &uat_ind;
+		if (vid == UAT_VENDOR_ID && cid == UAT_TWS_CODEC_ID)
+			return &uat_tws_ind;
+		break;
+	}
+
+	return NULL;
+}
