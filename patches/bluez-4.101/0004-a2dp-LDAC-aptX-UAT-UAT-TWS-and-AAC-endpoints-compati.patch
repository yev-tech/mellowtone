+/* HiBy: pick first bit of 'avail' in 'order' (0 if none) */
+static uint8_t hiby_pick(uint8_t avail, const uint8_t *order, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (avail & order[i])
+			return order[i];
+	return 0;
+}
+
+/* LDAC transport rate. 44.1 kHz is preferred by default: most music is
+ * 44.1 kHz, so no resampling is needed, and the LDAC encoder (which runs on
+ * the player's single X1000 core) has less than half the samples to encode
+ * than at 96 kHz. Verified that the stock player plays correctly at
+ * whatever rate is negotiated. A player may still ask for another rate
+ * while it runs by writing "<rate> <pid>" to this file. */
+#define HIBY_PREFER_RATE_PATH "/tmp/bt_prefer_rate"
+
+static unsigned int hiby_preferred_rate(void)
+{
+	unsigned int rate = 0;
+	long pid = 0;
+	char proc[32];
+	FILE *f = fopen(HIBY_PREFER_RATE_PATH, "r");
+
+	if (!f)
+		return 0;
+	/* "<rate> <pid>": honoured only while the writing player is alive */
+	if (fscanf(f, "%u %ld", &rate, &pid) != 2)
+		rate = 0;
+	fclose(f);
+	snprintf(proc, sizeof(proc), "/proc/%ld", pid);
+	if (rate && (pid <= 0 || access(proc, F_OK) != 0)) {
+		DBG("ignoring %s: pid %ld gone", HIBY_PREFER_RATE_PATH, pid);
+		return 0;
+	}
+	return rate;
+}
+
+/* Build our configuration for a remote AAC/vendor codec. 'r' is the remote
+ * media-codec info (media type, codec, ...). Returns length or 0. */
+static size_t hiby_select_params(const uint8_t *r, size_t rlen, uint8_t *out)
+{
+	static const uint8_t ldac_f_96k[] = { 0x04, 0x08, 0x10, 0x20 };
+	static const uint8_t ldac_f_44k1[] = { 0x20, 0x10, 0x08, 0x04 };
+	static const uint8_t ldac_f_48k[] = { 0x10, 0x20, 0x04, 0x08 };
+	const uint8_t *ldac_f = ldac_f_44k1;
+	static const uint8_t ldac_c[] = { 0x01, 0x02, 0x04 };
+	static const uint8_t uat_f[] = { 0x20, 0x10, 0x08, 0x04, 0x02, 0x01 };
+	static const uint8_t tws_f[] = { 0x08, 0x04, 0x02, 0x01 };
+	static const uint8_t uat_c[] = { 0x04, 0x02, 0x01 };
+	static const uint8_t aptx_f[] = { 0x02, 0x01, 0x04, 0x08 };
+	static const uint8_t aptx_c[] = { 0x02, 0x01 };
+	uint32_t vid;
+	uint16_t cid;
+	uint8_t f, c;
+
+	if (r[1] == A2DP_CODEC_MPEG24) {
+		if (rlen < 8)
+			return 0;
+		memset(out, 0, 8);
+		out[1] = A2DP_CODEC_MPEG24;
+		if (r[2] & 0x40)
+			out[2] = 0x40;			/* MPEG-4 AAC LC */
+		else if (r[2] & 0x80)
+			out[2] = 0x80;			/* MPEG-2 AAC LC */
+		else {
+			error("No supported aac object type");
+			return 0;
+		}
+		if (r[3] & 0x01)
+			out[3] = 0x01;			/* 44.1 kHz */
+		else if (r[4] & 0x80)
+			out[4] |= 0x80;			/* 48 kHz */
+		else {
+			error("No supported frequencies");
+			return 0;
+		}
+		if (r[4] & 0x04)
+			out[4] |= 0x04;			/* 2 channels */
+		else if (r[4] & 0x08)
+			out[4] |= 0x08;			/* 1 channel */
+		else {
+			error("No supported channel modes");
+			return 0;
+		}
+		out[4] |= r[4] & 0x03;			/* rfa */
+		out[5] = 0x04 | (r[5] & 0x80);		/* VBR as remote */
+		out[6] = 0xe2;				/* 320 kb/s */
+		out[7] = 0x00;
+		return 8;
+	}
+
+	if (r[1] != A2DP_CODEC_VENDOR || rlen < 9)
+		return 0;
+
+	vid = r[2] | r[3] << 8 | r[4] << 16 | (uint32_t) r[5] << 24;
+	cid = r[6] | r[7] << 8;
+	memcpy(out, r, 8);
+	out[0] = 0x00;
+
+	if (vid == APTX_VENDOR_ID && cid == APTX_CODEC_ID) {
+		f = hiby_pick(r[8] >> 4, aptx_f, sizeof(aptx_f));
+		c = hiby_pick(r[8] & 0x0f, aptx_c, sizeof(aptx_c));
+		if (!f || !c) {
+			error("No supported aptX configuration");
+			return 0;
+		}
+		out[8] = f << 4 | c;
+		return 9;
+	}
+
+	if (rlen < 10)
+		return 0;
+
+	if (vid == LDAC_VENDOR_ID && cid == LDAC_CODEC_ID) {
+		switch (hiby_preferred_rate()) {
+		case 48000:
+			ldac_f = ldac_f_48k;
+			break;
+		case 96000:
+			ldac_f = ldac_f_96k;
+			break;
+		}
+		f = hiby_pick(r[8], ldac_f, sizeof(ldac_f_44k1));
+		c = hiby_pick(r[9], ldac_c, sizeof(ldac_c));
+	} else if (vid == UAT_VENDOR_ID && cid == UAT_CODEC_ID) {
+		f = hiby_pick(r[8], uat_f, sizeof(uat_f));
+		c = hiby_pick(r[9], uat_c, sizeof(uat_c));
+	} else if (vid == UAT_VENDOR_ID && cid == UAT_TWS_CODEC_ID) {
+		f = hiby_pick(r[8], tws_f, sizeof(tws_f));
+		c = hiby_pick(r[9], uat_c, sizeof(uat_c));
+	} else
+		return 0;
+
+	if (!f || !c) {
+		error("No supported vendor codec configuration");
+		return 0;
+	}
+	out[8] = f;
+	out[9] = c;
+	return 10;
+}
