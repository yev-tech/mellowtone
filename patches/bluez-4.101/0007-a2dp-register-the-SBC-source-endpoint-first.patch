From: yev-tech <347553623+yev-tech@users.noreply.github.com>
Date: Mon, 5 Oct 2026 18:06:12 -0400
Subject: [PATCH] a2dp: register the SBC source endpoint first

Some car stereos read only the first endpoint and configure it with
SBC whatever its codec. With LDAC first, a Subaru head unit set up an
SBC stream on the LDAC endpoint, and the ALSA plugin could never open
it ("seid 1 not available or locked"): no audio in the car. SBC first
gives such remotes an endpoint that matches; remotes that read every
endpoint choose by codec, and connections we start choose themselves.
---
 audio/a2dp.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/audio/a2dp.c b/audio/a2dp.c
index 6339530..a25b573 100644
--- a/audio/a2dp.c
+++ b/audio/a2dp.c
@@ -1804,10 +1804,20 @@ proceed:
 		a2dp_add_sep(src, t, codec, delay_reporting, \
 				NULL, NULL, NULL, NULL)
 
-	/* Registration order = SEID order = remote's preference order.
-	 * Matches HiBy stock: LDAC, aptX, UAT, UAT-TWS, AAC, SBC, MPEG12. */
+	/* Registration order = SEID order. SBC, the one codec every sink
+	 * supports, comes first: some car stereos read only the first
+	 * endpoint and configure it with SBC whatever its codec (seen with a
+	 * Subaru head unit), which left a stream the ALSA plugin could never
+	 * open on the LDAC endpoint. Devices that read every endpoint choose
+	 * by codec, and when we connect we choose ourselves, so the order
+	 * only matters to such remotes. HiBy stock registers SBC after AAC. */
 	server->source_enabled = source;
 	if (source) {
+		for (i = 0; i < sbc_srcs; i++)
+			a2dp_add_sep(src, AVDTP_SEP_TYPE_SOURCE,
+					A2DP_CODEC_SBC, delay_reporting,
+					NULL, NULL, NULL, NULL);
+
 		ADD_VENDOR(AVDTP_SEP_TYPE_SOURCE, ldac_srcs, LDAC_VENDOR_ID,
 							LDAC_CODEC_ID);
 		ADD_VENDOR(AVDTP_SEP_TYPE_SOURCE, aptx_srcs, APTX_VENDOR_ID,
@@ -1819,11 +1829,6 @@ proceed:
 		ADD_STD(AVDTP_SEP_TYPE_SOURCE, aac_srcs, A2DP_CODEC_MPEG24);
 	}
 	if (source) {
-		for (i = 0; i < sbc_srcs; i++)
-			a2dp_add_sep(src, AVDTP_SEP_TYPE_SOURCE,
-					A2DP_CODEC_SBC, delay_reporting,
-					NULL, NULL, NULL, NULL);
-
 		for (i = 0; i < mpeg12_srcs; i++)
 			a2dp_add_sep(src, AVDTP_SEP_TYPE_SOURCE,
 					A2DP_CODEC_MPEG12, delay_reporting,
