From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mt <mt@localhost>
Date: Mon, 5 Oct 2026 22:05:53 +0000
Subject: [PATCH] avrcp: advertise AVRCP target 1.3, which the tested car
 stereos expect.

---
 audio/avrcp.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/audio/avrcp.c b/audio/avrcp.c
index 89ee112..e808610 100644
--- a/audio/avrcp.c
+++ b/audio/avrcp.c
@@ -257,7 +257,9 @@ static sdp_record_t *avrcp_tg_record(void)
 	sdp_record_t *record;
 	sdp_data_t *psm, *version, *features;
 	uint16_t lp = AVCTP_PSM;
-	uint16_t avrcp_ver = 0x0104, avctp_ver = 0x0103;
+	/* R3Pro: advertise AVRCP 1.3 like HiBy's stock daemon. With 1.4 some car
+	 * head units take their 1.4 path and never enable controls. */
+	uint16_t avrcp_ver = 0x0103, avctp_ver = 0x0103;
 	uint16_t feat = ( AVRCP_FEATURE_CATEGORY_1 |
 					AVRCP_FEATURE_CATEGORY_2 |
 					AVRCP_FEATURE_CATEGORY_3 |
