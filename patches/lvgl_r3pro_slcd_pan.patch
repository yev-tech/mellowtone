+#if defined(LV_LINUX_FBDEV_PAN_EACH_FRAME) && LV_LINUX_FBDEV_PAN_EACH_FRAME && !LV_LINUX_FBDEV_BSD
+bool lv_linux_fbdev_set_panel_sleep(lv_display_t * disp, bool sleep)
+{
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || dsc->fbfd < 0) return false;
+    if(dsc->panel_asleep == sleep) return true;
+
+    /* jzfb vendor ioctl 0x80044620 with 1 stops the SLCD controller
+     * (no vsync, no transfers), 0 starts it again. The stock UI wakes with
+     * 0 and then pans once to restart the transfers. */
+    int arg = sleep ? 1 : 0;
+    if(ioctl(dsc->fbfd, 0x80044620, &arg) != 0) {
+        perror("ioctl(jzfb sleep)");
+        if(sleep) return false;
+    }
+    dsc->panel_asleep = sleep;
+    if(!sleep && ioctl(dsc->fbfd, FBIOPAN_DISPLAY, &dsc->vinfo) == -1) perror("Error panning display");
+    return true;
+}
+#endif
